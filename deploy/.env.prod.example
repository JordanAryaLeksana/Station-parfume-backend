# Env production untuk deploy/docker-compose.prod.yml — panduan: docs/deploy-vps.md
#
#   cp deploy/.env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
#
# File ini dibaca docker compose (container db, redis, caddy) DAN server Go.
# Aturan menulis nilai:
#   - Nilai rahasia dibuat dengan: openssl rand -hex 32   (hanya huruf a-f dan angka)
#   - Jangan pakai $, spasi, atau tanda kutip di nilai (docker compose menafsirkan $).
#   - Komentar di baris sendiri, jangan di belakang nilai.
# deploy/.env.prod sudah di .gitignore — JANGAN di-commit.

# ---------------- Domain
# Domain API. DNS record A → IP VPS (lihat runbook soal AAAA/IPv6).
# Caddy mengambil & memperpanjang sertifikat HTTPS otomatis.
API_DOMAIN=api.example.com
# Opsional, hanya untuk uji lokal (default 80 dan 443):
# HTTP_PORT=80
# HTTPS_PORT=443

# ---------------- Server
GIN_MODE=release
PORT=8080
# Subnet jaringan internal di docker-compose.prod.yml. Hanya Caddy yang berada
# di depan api, jadi IP asli pembeli diambil dari X-Forwarded-For buatan Caddy
# (penting untuk rate limit login).
TRUSTED_PROXIES=172.30.10.0/24
# Swagger /docs: mati di production.
API_DOCS_ENABLED=false

# ---------------- Database (container db; juga dipakai membuat user & database-nya)
DB_HOST=db
DB_PORT=5432
DB_USER=stationparfume
DB_PASSWORD=
DB_NAME=stationparfume
# Koneksi hanya lewat jaringan internal Docker di VPS yang sama (tidak keluar
# server), jadi tanpa TLS. Kalau DB dipindah ke server/layanan lain: require.
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
DB_LOG_LEVEL=warn

# ---------------- Redis (container redis; password juga dipasang ke redis-nya)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------- JWT: dua nilai acak yang BERBEDA (openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------------- Frontend & CORS
# Halaman frontend (tujuan setelah login Google).
FRONTEND_URL=https://example.com
# Domain frontend yang boleh memanggil API dari browser, dipisah koma, tanpa path.
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# ---------------- Google OAuth
# Google Cloud Console → Credentials → OAuth client → Authorized redirect URIs:
# isi PERSIS sama dengan GOOGLE_REDIRECT_URL (termasuk /api/v1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.example.com/api/v1/auth/google/callback

# ---------------- Xendit (Payment Sessions)
# Pakai secret key LIVE hanya setelah aktivasi akun disetujui; sebelum itu key TEST.
# Kosong = server tetap jalan, endpoint bayar & webhook menjawab 503.
XENDIT_SECRET_KEY=
# Dashboard Xendit → Settings → Webhooks → verification token.
XENDIT_WEBHOOK_TOKEN=
# Halaman frontend setelah bayar / batal (WAJIB HTTPS; ?order=<nomor> ditambahkan otomatis).
CHECKOUT_SUCCESS_URL=https://example.com/checkout/sukses
CHECKOUT_CANCEL_URL=https://example.com/checkout/batal
# Opsional: batas umur link bayar (default 24h, minimal 15m).
# XENDIT_SESSION_MAX_TTL=24h
