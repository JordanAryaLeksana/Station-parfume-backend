# Pembayaran: Xendit Payment Sessions (Dashboard Xendit → Settings → API Keys & Webhooks).
# Pakai secret key TEST untuk development. Kalau kosong, server tetap jalan tapi
# POST /orders/:id/pay dan webhook menjawab 503.
XENDIT_SECRET_KEY=
# Token "Webhook verification token" dari Dashboard (dicocokkan dengan header x-callback-token).
XENDIT_WEBHOOK_TOKEN=
# Opsional: default https://api.xendit.co
XENDIT_API_URL=
# Opsional: batas umur sesi bayar (default 24h, minimal 15m)
XENDIT_SESSION_MAX_TTL=
# Halaman frontend setelah bayar/batal (WAJIB HTTPS; ?order=<nomor order> ditambahkan otomatis).
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
