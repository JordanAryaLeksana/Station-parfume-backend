# Database (PostgreSQL). Server, ./cmd/migrate, dan ./seed membaca env yang sama.
# Pilih SALAH SATU:
#   a) DATABASE_URL lengkap, mis. postgres://user:pass@host:5432/db?sslmode=require&TimeZone=Asia/Jakarta
#      (tulis TimeZone apa adanya, jangan di-escape jadi Asia%2FJakarta)
#   b) potongan DB_* di bawah (password otomatis di-escape). docker-compose.yml juga
#      memakai DB_USER/DB_PASSWORD/DB_NAME/DB_PORT ini untuk container Postgres lokal.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5433
DB_USER=stationparfume
DB_PASSWORD=
DB_NAME=station-parfume-db
# disable | prefer (default) | require | verify-full — production: require atau verify-full
DB_SSLMODE=
DB_TIMEZONE=Asia/Jakarta
# Log query GORM: silent | error | warn (default) | info. Nilai parameter tidak pernah dicetak.
DB_LOG_LEVEL=
# Schema TIDAK dibuat saat server start. Setelah DB siap / setiap deploy: go run ./cmd/migrate up

# Redis
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# JWT — WAJIB: masing-masing minimal 32 karakter acak dan keduanya BERBEDA
# (server menolak start kalau tidak). Contoh membuat: openssl rand -base64 48
JWT_SECRET=station-parfume-jwt-secret-2026-dev
JWT_REFRESH_SECRET=station-parfume-refresh-secret-2026-dev

# Server
# TRUSTED_PROXIES: IP/CIDR reverse proxy (mis. "127.0.0.1" untuk nginx lokal), dipisah koma.
# Kosong = X-Forwarded-For diabaikan (IP klien dari koneksi langsung; penting untuk rate limit).
TRUSTED_PROXIES=
PORT=8080
GIN_MODE=debug

# Google OAuth (isi nanti). Scope: openid email profile.
# FRONTEND_URL wajib untuk login Google: setelah login diarahkan ke
# FRONTEND_URL/oauth-success#access_token=...&refresh_token=... (token di fragment, bukan query)
# atau FRONTEND_URL/oauth-success#error=<kode>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Pembayaran: Xendit Payment Sessions (Dashboard Xendit → Settings → API Keys & Webhooks).
# Pakai secret key TEST untuk development. Kalau kosong, server tetap jalan tapi
# POST /orders/:id/pay dan webhook menjawab 503.
XENDIT_SECRET_KEY=
# Token "Webhook verification token" dari Dashboard (dicocokkan dengan header x-callback-token).
XENDIT_WEBHOOK_TOKEN=
# Opsional: default https://api.xendit.co
XENDIT_API_URL=
# Opsional: batas umur sesi bayar (default 24h, minimal 15m)
XENDIT_SESSION_MAX_TTL=
# Halaman frontend setelah bayar/batal (WAJIB HTTPS; ?order=<nomor order> ditambahkan otomatis).
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
