# Database (PostgreSQL). Server, ./cmd/migrate, dan ./seed membaca env yang sama.
# Pilih SALAH SATU:
#   a) DATABASE_URL lengkap, mis. postgres://user:pass@host:5432/db?sslmode=require&TimeZone=Asia/Jakarta
#      (tulis TimeZone apa adanya, jangan di-escape jadi Asia%2FJakarta)
#   b) potongan DB_* di bawah (password otomatis di-escape). docker-compose.yml juga
#      memakai DB_USER/DB_PASSWORD/DB_NAME/DB_PORT ini untuk container Postgres lokal.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5433
DB_USER=stationparfume
DB_PASSWORD=
DB_NAME=station-parfume-db
# disable | prefer (default) | require | verify-full — production: require atau verify-full
DB_SSLMODE=
DB_TIMEZONE=Asia/Jakarta
# Log query GORM: silent | error | warn (default) | info. Nilai parameter tidak pernah dicetak.
DB_LOG_LEVEL=
# Schema TIDAK dibuat saat server start. Setelah DB siap / setiap deploy: go run ./cmd/migrate up

# Redis
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# JWT — WAJIB: masing-masing minimal 32 karakter acak dan keduanya BERBEDA
# (server menolak start kalau tidak). Contoh membuat: openssl rand -base64 48
JWT_SECRET=station-parfume-jwt-secret-2026-dev
JWT_REFRESH_SECRET=station-parfume-refresh-secret-2026-dev

# Server
# TRUSTED_PROXIES: IP/CIDR reverse proxy (mis. "127.0.0.1" untuk nginx lokal), dipisah koma.
# Kosong = X-Forwarded-For diabaikan (IP klien dari koneksi langsung; penting untuk rate limit).
TRUSTED_PROXIES=
PORT=8080
# debug (development) | release (WAJIB di production) | test
GIN_MODE=debug
# CORS: domain frontend yang boleh memanggil API dari browser, dipisah koma, format
# scheme://host[:port] tanpa path. "*" ditolak. Kosong = pakai origin FRONTEND_URL.
# Origin lain dijawab 403. Contoh: https://stationparfume.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=
# Swagger UI di /docs (spec: /docs/openapi.yaml). Kosong = aktif kecuali GIN_MODE=release.
API_DOCS_ENABLED=

# Google OAuth (isi nanti). Scope: openid email profile.
# FRONTEND_URL wajib untuk login Google: setelah login diarahkan ke
# FRONTEND_URL/oauth-success#access_token=...&refresh_token=... (token di fragment, bukan query)
# atau FRONTEND_URL/oauth-success#error=<kode>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Pembayaran: Midtrans Snap (Dashboard Midtrans → Settings → Access Keys).
# Development pakai server key SANDBOX (diawali SB-Mid-server-). Kalau kosong, server
# tetap jalan tapi POST /orders/:id/pay dan webhook menjawab 503.
# Server key juga dipakai memverifikasi signature notifikasi (tidak ada token terpisah).
MIDTRANS_SERVER_KEY=
# true = production (key Mid-server-...). Default false = sandbox.
MIDTRANS_IS_PRODUCTION=false
# Opsional: override URL API (default sesuai MIDTRANS_IS_PRODUCTION).
MIDTRANS_SNAP_URL=
MIDTRANS_API_URL=
# Opsional: batas umur link bayar (default 24h, minimal 15m)
PAYMENT_SESSION_MAX_TTL=
# Halaman frontend setelah bayar (callbacks.finish Snap). HTTPS; http hanya untuk localhost.
# ?order=<nomor order> ditambahkan otomatis. Halaman batal/unfinish diatur di
# Dashboard Midtrans → Settings → Snap Preferences.
CHECKOUT_SUCCESS_URL=
# Notifikasi: Dashboard Midtrans → Settings → Configuration → Payment Notification URL
# = https://<domain-api>/api/v1/webhooks/midtrans (development: pakai ngrok dsb.).
